# Copy to .env and fill in. Never commit .env.

# --- Roboflow (Phase 1) ---
# https://app.roboflow.com  -> Settings -> API Keys
ROBOFLOW_API_KEY=
# A Roboflow Universe vehicle-detection model, as "workspace/project/version".
ROBOFLOW_MODEL_ID=vehicle-detection-3mmwj/1

# --- Gemini (Phase 1) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 511NY (Phase 3 / additive; requires approved developer access request) ---
# https://511ny.org/developers/resources
NY511_API_KEY=

# --- GCP (Phase 3) ---
GCP_PROJECT_ID=
GCS_BUCKET=
# Set to "gcp" to use Cloud Storage + Firestore instead of the local filesystem.
STORAGE_BACKEND=local
