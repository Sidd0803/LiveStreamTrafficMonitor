# Copy to .env and fill in. Never commit .env.

# --- Roboflow (Phase 1) ---
# https://app.roboflow.com  -> Settings -> API Keys
ROBOFLOW_API_KEY=

# Direct model inference. Used when no workflow is set below, and as the
# automatic fallback if the workflow call fails.
ROBOFLOW_MODEL_ID=yolov8m-640

# Hosted Workflow: "one image in, vehicle boxes out" (detection only).
# Leave blank to skip the workflow and call the model directly.
# Find the workspace slug and workflow id in the workflow's URL in the
# Roboflow app, or in the code snippet on its deploy panel.
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
# Only change these if the workflow's input/output blocks were named
# differently from the defaults.
ROBOFLOW_WORKFLOW_IMAGE_KEY=image
ROBOFLOW_WORKFLOW_OUTPUT_KEY=vehicle_boxes

# --- Gemini (Phase 1) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# models.list() is not a reliable availability check — it still advertises
# gemini-2.5-flash, which generateContent rejects for newer keys.
GEMINI_MODEL=gemini-3.6-flash

# --- 511NY (Phase 3 / additive; requires approved developer access request) ---
# https://511ny.org/developers/resources
NY511_API_KEY=

# --- GCP (Phase 3) ---
GCP_PROJECT_ID=
GCS_BUCKET=
# Set to "gcp" to use Cloud Storage + Firestore instead of the local filesystem.
STORAGE_BACKEND=local
